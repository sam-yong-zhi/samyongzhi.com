---
interface Props {
  lang?: 'en' | 'id';
}
const { lang = 'en' } = Astro.props;

const url = lang === 'id' ? 'https://saweria.co/al1cel' : 'https://ko-fi.com/samyongzhi';

const line1 = lang === 'id'
  ? 'Kalau tulisan ini kasih kamu ide baru, sedikit pencerahan, atau sekadar terasa relate, kamu bisa traktir aku kopi virtual di Saweria.'
  : 'If this post resonates with you or gives you something useful to think about, you can buy me a virtual coffee on Ko-fi.';

const line2 = lang === 'id'
  ? 'Lumayan buat bantu website ini tetap jalan dan aku bisa terus nulis.'
  : 'It helps support the writing and keeps this little corner of the internet going.';

const linkText = lang === 'id' ? 'Traktir aku kopi virtual ☕' : 'Buy me a virtual coffee ☕';
---

<div class="kofi-note">
  <p>{line1}</p>
  <p>{line2}</p>
  <p><a href={url} target="_blank" rel="noopener noreferrer" class="kofi-btn">{linkText}</a></p>
</div>

<style>
  .kofi-note {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    color: var(--muted);
  }

  .kofi-note p {
    margin: 0 0 0.5rem;
    line-height: 1.7;
  }

  .kofi-note p:last-child {
    margin: 0;
  }

  .kofi-btn {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.5rem 1rem;
    font-size: 0.925rem;
    font-family: var(--font-sans);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .kofi-btn:hover {
    border-color: var(--muted);
  }
</style>

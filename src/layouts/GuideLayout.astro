---
import BaseLayout from './BaseLayout.astro';
import KofiNote from '../components/KofiNote.astro';

interface LangToggle {
  en: string;
  id: string | null;
  zh: string | null;
  active: 'en' | 'id' | 'zh';
}

interface Props {
  title: string;
  description: string;
  lastUpdated: Date;
  sections: { id: string; title: string }[];
  lang?: 'en' | 'id' | 'zh';
  langToggle?: LangToggle;
}

const { title, description, lastUpdated, sections, lang = 'en', langToggle } = Astro.props;

const dateLocale = lang === 'id' ? 'id-ID' : lang === 'zh' ? 'zh-CN' : 'en-US';
const formattedDate = lastUpdated.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const lastUpdatedLabel = lang === 'id' ? 'Terakhir diperbarui:' : lang === 'zh' ? '最后更新：' : 'Last updated:';
const jumpLabel = lang === 'id' ? 'Lompat ke bagian' : lang === 'zh' ? '跳转到章节' : 'Jump to section';
---

<BaseLayout title={title} description={description} lang={lang} langToggle={langToggle}>
  <div class="guide-wrapper">
    <aside class="guide-sidebar">
      <nav aria-label="Guide sections">
        {sections.map((section) => (
          <a href={`#${section.id}`} class="guide-sidebar__link" data-section={section.id}>
            {section.title}
          </a>
        ))}
      </nav>
    </aside>

    <article class="guide-article">
      <div class="guide-jump">
        <select aria-label={jumpLabel} id="guide-jump-select">
          <option value="">{jumpLabel}</option>
          {sections.map((section) => (
            <option value={section.id}>{section.title}</option>
          ))}
        </select>
      </div>

      <header class="guide-header">
        <h1>{title}</h1>
        <p class="guide-updated">{lastUpdatedLabel} {formattedDate}</p>
        <p class="guide-lead">{description}</p>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
  <KofiNote lang={lang} />
</BaseLayout>

<script>
  // Wrap tables for horizontal scroll on mobile
  document.querySelectorAll<HTMLTableElement>('.guide-article table').forEach((table) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'table-wrapper';
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });

  // Jump to section dropdown
  const select = document.getElementById('guide-jump-select') as HTMLSelectElement;
  select?.addEventListener('change', () => {
    if (select.value) {
      window.location.hash = select.value;
      select.value = '';
    }
  });

  // Active section highlighting via IntersectionObserver
  const links = document.querySelectorAll<HTMLAnchorElement>('.guide-sidebar__link');
  const headings = document.querySelectorAll<HTMLHeadingElement>('.guide-article h2[id]');

  if (links.length && headings.length) {
    let activeId = '';

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        }
        links.forEach((link) => {
          const isActive = link.dataset.section === activeId;
          link.classList.toggle('active', isActive);
        });
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>

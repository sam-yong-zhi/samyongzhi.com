---
import BaseLayout from './BaseLayout.astro';
import KofiNote from '../components/KofiNote.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: Date;
  sections: { id: string; title: string }[];
}

const { title, description, lastUpdated, sections } = Astro.props;

const formattedDate = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <div class="guide-wrapper">
    <aside class="guide-sidebar">
      <nav aria-label="Guide sections">
        {sections.map((section) => (
          <a href={`#${section.id}`} class="guide-sidebar__link" data-section={section.id}>
            {section.title}
          </a>
        ))}
      </nav>
    </aside>

    <article class="guide-article">
      <div class="guide-jump">
        <select aria-label="Jump to section" id="guide-jump-select">
          <option value="">Jump to section</option>
          {sections.map((section) => (
            <option value={section.id}>{section.title}</option>
          ))}
        </select>
      </div>

      <header class="guide-header">
        <h1>{title}</h1>
        <p class="guide-updated">Last updated: {formattedDate}</p>
        <p class="guide-lead">{description}</p>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
  <KofiNote lang="en" />
</BaseLayout>

<script>
  // Jump to section dropdown
  const select = document.getElementById('guide-jump-select') as HTMLSelectElement;
  select?.addEventListener('change', () => {
    if (select.value) {
      window.location.hash = select.value;
      select.value = '';
    }
  });

  // Active section highlighting via IntersectionObserver
  const links = document.querySelectorAll<HTMLAnchorElement>('.guide-sidebar__link');
  const headings = document.querySelectorAll<HTMLHeadingElement>('.guide-article h2[id]');

  if (links.length && headings.length) {
    let activeId = '';

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        }
        links.forEach((link) => {
          const isActive = link.dataset.section === activeId;
          link.classList.toggle('active', isActive);
        });
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allSummaries = await getCollection('summaries', (s) => !s.data.draft && s.id.endsWith('.id.md'));
const summaries = allSummaries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Ringkasan"
  description="Ringkasan singkat dari buku, artikel, dan ide."
  lang="id"
  langToggle={{ en: '/summaries', id: '', zh: '/zh/summaries', active: 'id' }}
>
  <div class="page-title">
    <h1>Ringkasan</h1>
    <p class="page-intro">Aku baca buku keuangan pertama di usia 17. Sejak itu, Kindle-ku saja sudah punya lebih dari seratus buku -- soal bisnis, uang, dan pengembangan diri -- belum termasuk buku-buku fisik yang aku baca ulang seperti buku teks. Para penulisnya, dengan caranya sendiri, jadi semacam mentor bagiku.</p>
    <p class="page-intro">Nggak ada yang ngajarin ini di sekolah -- atau setidaknya, nggak dengan cara yang benar-benar berarti. Gimana cara berpikir soal risiko, apa artinya "cukup", kapan harus belanja dan kapan nggak.</p>
    <p class="page-intro">Jadi aku nulis catatan-catatan ini terutama untuk anak-anak perempuanku. Aku ingin mereka punya catatan tentang cara ayah mereka berpikir soal uang dan kehidupan. Kalau kamu menemukan sesuatu yang berguna di sini, aku senang sudah bisa sedikit berkontribusi buat hidupmu.</p>
  </div>

  <div class="post-list">
    {summaries.map((summary) => {
      const slug = summary.id.replace(/\.id\.md$/, '');
      const formattedDate = summary.data.date.toLocaleDateString('id-ID', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      return (
        <div class="post-card">
          <a href={`/id/summaries/${slug}`} class="post-card__title">{summary.data.title}</a>
          <p class="post-card__desc">{summary.data.author} · {summary.data.year}</p>
          <p class="post-card__meta">{formattedDate}</p>
        </div>
      );
    })}
  </div>
</BaseLayout>

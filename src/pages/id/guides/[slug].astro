---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft && g.id.endsWith('.id.md'));
  const allGuides = await getCollection('guides', (g) => !g.data.draft && g.id.endsWith('.zh.md'));
  const zhSlugs = new Set(allGuides.map((g) => g.id.replace(/\.zh\.md$/, '')));
  return guides.map((guide) => {
    const slug = guide.id.replace(/\.id\.md$/, '');
    return {
      params: { slug },
      props: {
        guide,
        langToggle: {
          en: `/guides/${slug}`,
          id: '',
          zh: zhSlugs.has(slug) ? `/zh/guides/${slug}` : null,
          active: 'id' as const,
        },
      },
    };
  });
}

const { guide, langToggle } = Astro.props;
const { title, description, lastUpdated, sections } = guide.data;
const { Content } = await render(guide);
---

<GuideLayout title={title} description={description} lastUpdated={lastUpdated} sections={sections} lang="id" langToggle={langToggle}>
  <Content />
</GuideLayout>

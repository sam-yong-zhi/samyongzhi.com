---
import BaseLayout from '../layouts/BaseLayout.astro';
// import SubscribeForm from '../components/SubscribeForm.astro';
---

<BaseLayout
  title="Buy Me a Coffee"
  description="If something I've written has been useful to you, you can buy me a virtual coffee on Ko-fi to help keep the writing going."
  langToggle={{ en: '', id: '/id/subscribe', zh: '/zh/subscribe', active: 'en' }}
>
  <div class="coffee-page">
    <h1>Buy Me a Coffee</h1>
    <p>
      I write about parenting, money, and living more deliberately. If something here has been
      useful to you, you can buy me a virtual coffee on Ko-fi. No obligation at all. It's
      just a small way to say the writing added something to your day.
    </p>
    <a
      href="https://ko-fi.com/samyongzhi"
      target="_blank"
      rel="noopener noreferrer"
      class="kofi-btn"
    >Buy me a virtual coffee ☕</a>
  </div>
</BaseLayout>

<style>
  .coffee-page {
    max-width: var(--max-w);
    padding-top: 2rem;
  }

  .coffee-page h1 {
    margin-bottom: 1rem;
  }

  .coffee-page p {
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .kofi-btn {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.5rem 1rem;
    font-size: 0.925rem;
    font-family: var(--font-sans);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .kofi-btn:hover {
    border-color: var(--muted);
  }
</style>

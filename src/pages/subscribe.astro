---
import BaseLayout from '../layouts/BaseLayout.astro';
// import SubscribeForm from '../components/SubscribeForm.astro';
---

<BaseLayout
  title="Buy Me a Coffee"
  description="If something I've written has been useful to you, you can buy me a virtual coffee on Ko-fi to help keep the writing going."
  langToggle={{ en: '', id: '/id/subscribe', active: 'en' }}
>
  <div class="coffee-page">
    <h1>Buy Me a Coffee</h1>
    <p>
      I write about parenting, money, and living more deliberately. If something here has been
      useful to you, you can buy me a virtual coffee on Ko-fi. There's no obligation — it's
      just a small way to say the writing added something to your day.
    </p>
    <a
      href="https://ko-fi.com/samyongzhi"
      target="_blank"
      rel="noopener noreferrer"
      class="kofi-link"
    >Buy me a coffee on Ko-fi &rarr;</a>
  </div>
</BaseLayout>

<style>
  .coffee-page {
    max-width: var(--max-w);
    padding-top: 2rem;
  }

  .coffee-page h1 {
    margin-bottom: 1rem;
  }

  .coffee-page p {
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }

  .kofi-link {
    font-family: var(--font-sans);
    font-size: 0.925rem;
    color: var(--muted);
  }

  .kofi-link:hover {
    color: var(--text);
  }
</style>

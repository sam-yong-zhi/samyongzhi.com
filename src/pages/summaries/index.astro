---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allSummaries = await getCollection('summaries', (s) => !s.data.draft && !s.id.endsWith('.id.md') && !s.id.endsWith('.zh.md'));
const summaries = allSummaries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Summaries"
  description="Short distillations of books, articles, and ideas."
  langToggle={{ en: '', id: '/id/summaries', zh: '/zh/summaries', active: 'en' }}
>
  <div class="page-title">
    <h1>Summaries</h1>
    <p class="page-intro">I read my first personal finance book at 17. My Kindle alone has over a hundred books since then, across business, money, and self-improvement, before counting the physical ones I revisit like textbooks. These authors have become something like mentors to me.</p>
    <p class="page-intro">None of this was taught in school, or at least not in any meaningful way. How to think about risk, what "enough" means, when to spend and when not to.</p>
    <p class="page-intro">So I write these summaries mainly for my daughters. I want them to have a record of how their father thought about money and life. If you find something useful here, I am glad I made a small contribution to your life.</p>
  </div>

  <div class="post-list">
    {summaries.map((summary) => {
      const slug = summary.id.replace(/\.md$/, '');
      const formattedDate = summary.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      return (
        <div class="post-card">
          <a href={`/summaries/${slug}`} class="post-card__title">{summary.data.title}</a>
          <p class="post-card__desc">{summary.data.author} · {summary.data.year}</p>
          <p class="post-card__meta">{formattedDate}</p>
        </div>
      );
    })}
  </div>
</BaseLayout>

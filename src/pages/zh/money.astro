---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (post) => !post.data.draft && post.id.endsWith('.zh.md') && post.data.categories.includes('money'));
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="财务"
  description="怎么给家庭建立财务安全感。一些实用的思考。"
  lang="zh"
  langToggle={{ en: '/money', id: '/id/money', zh: '', active: 'zh' }}
>
  <div class="page-title">
    <h1>财务</h1>
    <p>怎么给家庭建立财务安全感。一些实用的思考。</p>
  </div>

  <ul class="filter-bar">
    <li><a href="/zh/blog">全部</a></li>
    <li><a href="/zh/parenting">育儿</a></li>
    <li><a href="/zh/money" class="active">财务</a></li>
    <li><a href="/zh/ai-and-work">AI 与职场</a></li>
  </ul>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} lang="zh" />)}
  </div>
</BaseLayout>

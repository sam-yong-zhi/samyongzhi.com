---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft && g.id.endsWith('.zh.md'));
  const allGuides = await getCollection('guides', (g) => !g.data.draft);
  const idSlugs = new Set(
    allGuides.filter((g) => g.id.endsWith('.id.md')).map((g) => g.id.replace(/\.id\.md$/, ''))
  );
  return guides.map((guide) => {
    const slug = guide.id.replace(/\.zh\.md$/, '');
    return {
      params: { slug },
      props: {
        guide,
        langToggle: {
          en: `/guides/${slug}`,
          id: idSlugs.has(slug) ? `/id/guides/${slug}` : null,
          zh: '',
          active: 'zh' as const,
        },
      },
    };
  });
}

const { guide, langToggle } = Astro.props;
const { title, description, lastUpdated, sections } = guide.data;
const { Content } = await render(guide);
---

<GuideLayout title={title} description={description} lastUpdated={lastUpdated} sections={sections} lang="zh" langToggle={langToggle}>
  <Content />
</GuideLayout>

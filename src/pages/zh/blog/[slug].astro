---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  function idToSlug(id: string) { return id.replace(/\.(en|id|zh)\.md$/, ''); }
  const zhPosts = await getCollection('blog', (post) =>
    !post.data.draft && post.id.endsWith('.zh.md')
  );
  const enPosts = await getCollection('blog', (post) =>
    !post.data.draft && post.id.endsWith('.en.md')
  );
  const idPosts = await getCollection('blog', (post) =>
    !post.data.draft && post.id.endsWith('.id.md')
  );
  const enSlugs = new Set(enPosts.map((p) => idToSlug(p.id)));
  const idSlugs = new Set(idPosts.map((p) => idToSlug(p.id)));
  return zhPosts.map((post) => {
    const slug = idToSlug(post.id);
    return {
      params: { slug },
      props: {
        post,
        langToggle: {
          en: enSlugs.has(slug) ? `/blog/${slug}` : '/',
          id: idSlugs.has(slug) ? `/id/blog/${slug}` : null,
          zh: '',
          active: 'zh' as const,
        },
      },
    };
  });
}

const { post, langToggle } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} langToggle={langToggle}>
  <Content />
</PostLayout>

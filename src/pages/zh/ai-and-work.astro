---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (post) => !post.data.draft && post.id.endsWith('.zh.md') && post.data.categories.includes('ai-and-work'));
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="AI 与职场"
  description="不吹，也不黑。清醒地看看正在发生什么——以及对你的职业到底意味着什么。"
  lang="zh"
  langToggle={{ en: '/ai-and-work', id: '/id/ai-and-work', zh: '', active: 'zh' }}
>
  <div class="page-title">
    <h1>AI 与职场</h1>
    <p>不吹，也不黑。清醒地看看正在发生什么——以及对你的职业到底意味着什么。</p>
  </div>

  <ul class="filter-bar">
    <li><a href="/zh/blog">全部</a></li>
    <li><a href="/zh/parenting">育儿</a></li>
    <li><a href="/zh/money">财务</a></li>
    <li><a href="/zh/ai-and-work" class="active">AI 与职场</a></li>
  </ul>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} lang="zh" />)}
  </div>
</BaseLayout>

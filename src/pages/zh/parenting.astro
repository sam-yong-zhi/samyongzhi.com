---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (post) => !post.data.draft && post.id.endsWith('.zh.md') && post.data.categories.includes('parenting'));
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="育儿"
  description="在快速变化的世界里养孩子的真实记录。"
  lang="zh"
  langToggle={{ en: '/parenting', id: '/id/parenting', zh: '', active: 'zh' }}
>
  <div class="page-title">
    <h1>育儿</h1>
    <p>在快速变化的世界里养孩子的真实记录。</p>
  </div>

  <ul class="filter-bar">
    <li><a href="/zh/blog">全部</a></li>
    <li><a href="/zh/parenting" class="active">育儿</a></li>
    <li><a href="/zh/money">财务</a></li>
    <li><a href="/zh/ai-and-work">AI 与职场</a></li>
  </ul>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} lang="zh" />)}
  </div>
</BaseLayout>
